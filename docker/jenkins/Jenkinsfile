pipeline {
    // 최상단 agent any는 유지하되, Docker 명령이 필요한 스테이지는 별도 agent를 사용
    agent any

    environment {
        DOCKER_IMAGE = "diamini/private_cloud_app"
        REGISTRY_CREDENTIAL = "dockerhub-token"    // Secret text 형태로 DockerHub token 등록
        SONAR_HOST_URL = "http://192.168.119.135:9001"
        SSH_CREDENTIAL_ID = "ssh-test2"            // Jenkins에 등록한 SSH key credentials
        DEPLOY_SERVER = "192.168.119.136"          // 배포 서버 IP
        DOCKER_NETWORK = "docker_monitoring"       // docker-compose.yml에 정의된 네트워크
        APP_PORT = "8088"                           // Flask 앱 포트
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/seung9526/private_cloud_ubuntu.git'
            }
        }

        stage('SonarQube Analysis') {
            agent {
                docker {
                    image 'docker:latest'
                    args "-v /var/run/docker.sock:/var/run/docker.sock --network ${DOCKER_NETWORK}"
                }
            }
            steps {
                withCredentials([string(credentialsId: 'tonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh """
                        echo "Starting SonarQube Analysis using Docker CLI..."
                        docker run --rm \
                            --network ${DOCKER_NETWORK} \
                            -v \$(pwd):/usr/src \
                            -w /usr/src \
                            sonarsource/sonar-scanner-cli \
                            -Dsonar.projectKey=private_cloud_ubuntu \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=${SONAR_TOKEN}
                    """
                }
            }
        }

        stage('Build Docker Image') {
            // Docker CLI가 설치된 에이전트 사용
            agent {
                docker {
                    image 'docker:latest'
                    // 에이전트는 네트워크에 연결된 상태를 유지
                    args "-v /var/run/docker.sock:/var/run/docker.sock --network ${DOCKER_NETWORK}"
                }
            }
            steps {
                // BuildKit 오류 방지를 위해 --network 옵션 제거
                sh "docker build -t ${DOCKER_IMAGE}:latest ."
            }
        }

        stage('Push to DockerHub') {
            // Docker CLI가 설치된 에이전트 사용
            agent {
                docker {
                    image 'docker:latest'
                    args "-v /var/run/docker.sock:/var/run/docker.sock --network ${DOCKER_NETWORK}"
                }
            }
            steps {
                withCredentials([string(credentialsId: "${REGISTRY_CREDENTIAL}", variable: 'DOCKER_TOKEN')]) {
                    sh """
                        echo "🔐 Logging into DockerHub with token..."
                        echo "$DOCKER_TOKEN" | docker login -u "diamini" --password-stdin
                        echo "🚀 Pushing image to DockerHub..."
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    """
                }
            }
        }

        stage('Deploy to Remote Server') {
            agent any // SSH 접속만 하므로 메인 에이전트 사용
            steps {
                sshagent(credentials: ["${SSH_CREDENTIAL_ID}"]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no test2@${DEPLOY_SERVER} '
                            echo "🛠 Stopping existing container..."
                            docker stop private_cloud_app || true
                            docker rm private_cloud_app || true
                            echo "📦 Pulling latest image..."
                            docker pull ${DOCKER_IMAGE}:latest
                            echo "🚀 Running new container..."
                            docker run -d --name private_cloud_app -p ${APP_PORT}:${APP_PORT} ${DOCKER_IMAGE}:latest
                            echo "⏳ Waiting 5 seconds for app to start..."
                            sleep 5
                            echo "🔍 Checking health..."
                            curl -f http://localhost:${APP_PORT}/health || echo "Health check failed"
                        '
                    """
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-report.txt', allowEmptyArchive: true
        }
    }
}

